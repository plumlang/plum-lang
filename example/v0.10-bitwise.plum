
# Basic bitwise operations
drop(5 & 3)
drop(5 | 3)
drop(5 ^ 3)
drop(~5)

# Zero and identical operands
drop(0 & 0)
drop(0 | 0)
drop(7 & 7)
drop(7 ^ 7)
drop(7 | 7)

# Different bit patterns
drop(12 & 10)
drop(12 | 10)
drop(12 ^ 10)

# Negative operands
drop(-5 & 3)
drop(-5 | 3)
drop(-5 ^ 3)
drop(~0)
drop(~(-1))

# Logical operators must still work
drop(1 && 0)
drop(1 || 0)
drop(!1)
drop(!0)

# Operator precedence
drop(2 + 3 & 1)
drop(6 | 3 ^ 1 & 3)
drop((5 | 2) & 3)
drop(5 & 3 == 1)
drop(5 > 3 && 2 < 4)