if (10 > 5) {
    drop "TEST 1: PASS"
}

if (10 < 5) {
    drop "TEST 2: FAIL"
}

if (10 == 10) {
    drop "TEST 3: PASS"
} else {
    drop "TEST 3: FAIL"
}

if (10 != 10) {
    drop "TEST 4: FAIL"
} else {
    drop "TEST 4: PASS"
}

if (20 > 10) {
    drop "TEST 5: FIRST"
} else if (20 > 5) {
    drop "TEST 5: SECOND"
} else {
    drop "TEST 5: THIRD"
}

if (10 > 20) {
    drop "TEST 6: FIRST"
} else if (10 > 5) {
    drop "TEST 6: SECOND"
} else {
    drop "TEST 6: THIRD"
}

if (5 > 20) {
    drop "TEST 7: FIRST"
} else if (5 > 10) {
    drop "TEST 7: SECOND"
} else {
    drop "TEST 7: ELSE"
}

plant int score = (75)

if (score >= 90) {
    drop "TEST 8: A"
} else if (score >= 80) {
    drop "TEST 8: B"
} else if (score >= 70) {
    drop "TEST 8: C"
} else {
    drop "TEST 8: F"
}

plant int age = (21)

if (age > 18) {
    drop "TEST 9: ADULT"
} else {
    drop "TEST 9: MINOR"
}

plant bool ready = (true)

if (ready) {
    drop "TEST 10: READY"
} else {
    drop "TEST 10: NOT READY"
}

plant str name = ("Plum")

if (name == "Plum") {
    drop "TEST 11: MATCH"
} else {
    drop "TEST 11: NO MATCH"
}

if (10 > 5) {
    drop "TEST 12: FIRST"
    drop "TEST 12: SECOND"
    drop "TEST 12: THIRD"
}

if (10 < 5) {
    drop "TEST 13: WRONG"
} else {
    drop "TEST 13: FIRST"
    drop "TEST 13: SECOND"
}

if (10 > 5) {
    if (20 > 10) {
        drop "TEST 14: INNER PASS"
    } else {
        drop "TEST 14: INNER FAIL"
    }
} else {
    drop "TEST 14: OUTER FAIL"
}

plant int x = (15)

if (x > 20) {
    drop "TEST 15: OUTER FIRST"
} else if (x > 10) {
    if (x > 14) {
        drop "TEST 15: NESTED PASS"
    } else {
        drop "TEST 15: NESTED FAIL"
    }
} else {
    drop "TEST 15: OUTER ELSE"
}

if (5 > 2) {
    drop "TEST 16: PASS"
}

if (10 >= 10) {
    drop "TEST 17: PASS"
} else {
    drop "TEST 17: FAIL"
}

if (10 <= 10) {
    drop "TEST 18: PASS"
} else {
    drop "TEST 18: FAIL"
}